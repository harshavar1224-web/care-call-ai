# GEMINI_API_KEY: Required for LLM evals (caller simulator + judge).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this applet is hosted (needed for Retell tool callbacks and webhooks).
APP_URL="MY_APP_URL"

# Supabase PostgreSQL Database (SERVICE-ROLE key used strictly on server side)
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Retell AI Voice Configuration
RETELL_API_KEY="key_..."
RETELL_AGENT_ID="agent_..."

# Tool authentication secret (sent in X-Tool-Secret header from Retell)
TOOL_SECRET="carecall_super_secret_tool_key_2026"

# Admin dashboard password (used for cookie-authenticated admin session)
ADMIN_PASSWORD="clinic_admin_pass"

# Clinic default timezone (default Asia/Kolkata)
CLINIC_TIMEZONE="Asia/Kolkata"

# Port (3000 for AI Studio environment)
PORT=3000
